---
source: crates/executor/src/tests/sql/functions/table/flatten.rs
description: "r#\"WITH t1 AS (\n        SELECT 1 AS id, PARSE_JSON('{\"arr\": [10, 20]}') AS v\n        UNION ALL SELECT 2, PARSE_JSON('{\"arr\": [30]}')),\n       t2 AS (SELECT 'a' AS tag UNION ALL SELECT 'b')\n    SELECT id, tag, f.value FROM t1 CROSS JOIN t2, LATERAL FLATTEN(INPUT => v:arr) f;\"#"
---
Ok(
    [
        "+----+-----+-------+",
        "| id | tag | value |",
        "+----+-----+-------+",
        "| 1  | a   | 10    |",
        "| 1  | a   | 20    |",
        "| 2  | a   | 30    |",
        "| 1  | b   | 10    |",
        "| 1  | b   | 20    |",
        "| 2  | b   | 30    |",
        "+----+-----+-------+",
    ],
)
